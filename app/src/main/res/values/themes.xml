        <item name="colorPrimaryDark">@color/backgroundDark</item>
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSurface">@color/surfaceDark</item>
